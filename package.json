{
    "name": "quest-platform",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
        "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
        "db:seed": "node --env-file-if-exists=.env --import tsx src/server/db/seed.ts",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hello-pangea/dnd": "^18.0.1",
        "@tanstack/react-query": "^5.107.1",
        "express": "^5.3.0",
        "jspdf": "^4.0.0",
        "lucide-react": "^0.468.0",
        "pg": "^8.23.1",
        "qrcode": "^1.5.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-intl": "^12.1.6",
        "react-router": "^7.18.5",
        "tsx": "^4.23.15",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.5.0",
        "prettier": "3.9.10",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.1.0",
        "vite-plugin-singlefile": "^2.3.0",
        "vitest": "^4.1.12"
    }
}
